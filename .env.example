# PaperTrade — copy to .env (everything here can also be set from the dashboard ⚙ Settings UI)

# API key for whichever provider the tuner uses (only the selected provider's key is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# LLM strategy tuner
TUNER_ENABLED=true
TUNER_PROVIDER=anthropic
TUNER_MODEL=claude-opus-4-8
TUNER_INTERVAL_MS=3600000
